# =============================================================================
#  Prometheus settings: the template for your own .env file
# =============================================================================
#
#  HOW TO USE THIS FILE
#    1. Copy it (from the repo root):      cp .env.example .env
#    2. Open .env and replace every  <YOUR KEY HERE>  that you need (see "NEEDED FOR" below).
#    3. Never commit .env: it holds your keys and is already in .gitignore.
#
#  WHAT YOU NEED, BY WHAT YOU WANT TO RUN
#    The free replay of a recorded session (./run_ui.sh --replay)  -> NO keys at all. You can skip this file.
#    A live request on the web page (./run_ui.sh)                  -> OPENROUTER_API_KEY and FINNHUB_API_KEY
#    ... with "Refresh market data first" ticked (fresh bars/news)  -> also POLYGON_API_KEY (your Massive key)
#    Fetching SEC filings (10-Q text from EDGAR)                    -> also SEC_USER_AGENT
#    LangSmith tracing (optional)                                   -> LANGSMITH_API_KEY
#
#  A key you do not have: leave it EMPTY (e.g.  LANGSMITH_API_KEY= ) rather than keeping the placeholder.
#  Every setting can also be given as an environment variable, which wins over this file.
#  The Postgres account book needs NO setting here: scripts/setup_postgres.sh writes its own passwords to secrets/.
# =============================================================================


# --- LLM (OpenRouter) --------------------------------------------------------
# NEEDED FOR any live run. Every chat model of the desk is called through OpenRouter.
# Get a key at https://openrouter.ai/keys (it starts with sk-or-) and add a few dollars of credit.
OPENROUTER_API_KEY=<YOUR KEY HERE>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Prometheus

# The model of each agent (OpenRouter model ids). These are the tested defaults: leave them as they are.
DEFAULT_MODEL=openai/gpt-oss-120b                 # the Data Clerk (and the default for the others)
FAST_MODEL=qwen/qwen3-30b-a3b                     # quick helper calls
ADVISOR_MODEL=nvidia/nemotron-3-super-120b-a12b   # the Advisor
CRITIC_MODEL=z-ai/glm-5.3                         # the Critic: a different producer from the Advisor on purpose
# Optional overrides (the defaults shown are used when these stay commented out):
# ACCOUNT_MANAGER_MODEL=openai/gpt-oss-120b       # the Account Manager and RaiseFunds
# TRADER_MODEL=openai/gpt-oss-120b                # the Trader
# GUARD_MODEL=qwen/qwen3.8-max-0902               # the security guard's risk scorer
# JUDGE_MODEL=anthropic/claude-opus-5.5           # the offline evaluation's judge (scripts/run_offline_evals.py only)
ENABLE_THINKING=true


# --- Desk behaviour ----------------------------------------------------------
# true = the desk works at the real moment (live quotes). false = a SIMULATED clock: the close of the last trading
# day that has closed, priced from the stored daily bars. Nothing is ever sent to a real broker either way.
USE_LIVE_TRADING=true
# false = outside US market hours (9:30-16:00 Eastern, trading days) the Critic DENIES every recommendation ("market_closed"),
# so nothing is traded. Set it to true to try the desk in the evening or on a weekend.
IGNORE_MARKET_HOURS=false
# true = a recommendation the Advisor scored NEUTRAL counts as approved (the page's "Neutral" box sets it per run).
ALLOW_NEUTRAL_RECOMMENDATIONS=true
# true = the Account Manager may sell holdings to pay for a purchase the cash does not cover, without asking
# (the page's "Always raise funds" box sets it per run). Keep false unless you want that.
ALWAYS_RAISE_FUNDS=false


# --- Local FastMCP (the course labs' MCP server; not used by the web page) ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=stdio


# --- Market data -------------------------------------------------------------
# NEEDED FOR a live run: Finnhub gives the live quotes, company lookups, news and analyst ratings.
# Get a key at https://finnhub.io/register
FINNHUB_API_KEY=<YOUR KEY HERE>
# NEEDED FOR "Refresh market data first" (daily bars, news, press releases, splits). Massive is the renamed
# Polygon.io: get the key at https://massive.com and put it in POLYGON_API_KEY, the name the code reads.
POLYGON_API_KEY=<YOUR KEY HERE>
# The same Massive key under its new name. Not read by the code today; it can stay empty.
MASSIVE_API_KEY=<YOUR KEY HERE>


# --- Tracing (optional) ------------------------------------------------------
# LangSmith traces every agent step (https://smith.langchain.com, Settings -> API Keys). Leave it EMPTY to run without
# tracing, or keep a key and set LANGSMITH_TRACING=false to switch tracing off. Never set LANGSMITH_PROJECT.
LANGSMITH_API_KEY=<YOUR KEY HERE>
# LANGSMITH_TRACING=false


# --- Trading simulation ------------------------------------------------------
# Must stay true: the Trader fills on a simulated (paper or backtest) broker only.
PAPER_TRADING=true
INITIAL_CASH=1000


# --- SEC EDGAR ---------------------------------------------------------------
# NEEDED ONLY to fetch the text of 10-Q filings from sec.gov. The SEC asks every client to say who it is:
# a name and a contact e-mail, e.g.  SEC_USER_AGENT=Jane Doe jane@example.com
SEC_USER_AGENT=<NAME> <YOUR EMAIL HERE>


# --- Local Hugging Face model (the Module 1 lab demo: python main.py) -------
# Not used by the trading desk or the web page.
LOCAL_MODEL=Qwen/Qwen3-4B
# LOCAL_MODEL=Qwen/Qwen3-1.7B
# LOCAL_MODEL=Qwen/Qwen3-0.6B
# Optional: set to skip HITL elicitation in main.py (same as --symbol)
# SMOKE_SYMBOL=AAPL
