# Copy to .env and fill in values. Never commit .env.

# --- Local HF CausalLM (main.py / Lab 1.1 port) ---
# Used by prometheus.models.llm.LocalLLM when you run: python main.py
LOCAL_MODEL=Qwen/Qwen3-4B
# LOCAL_MODEL=Qwen/Qwen3-1.7B
# LOCAL_MODEL=Qwen/Qwen3-0.6B
# Optional: set to skip HITL elicitation in main.py (same as --symbol)
# SMOKE_SYMBOL=AAPL

# --- LLM (OpenRouter) ---
# Used later by LangChain / LangGraph / OpenAI-compatible clients.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Prometheus

# Default / cheaper models for Data Clerk, Trader, Account Manager
DEFAULT_MODEL=openai/gpt-oss-120b
FAST_MODEL=qwen/qwen3-30b-a3b

# Stronger reasoning models for Advisor & Critic (adjust as you prefer)
ADVISOR_MODEL=nvidia/nemotron-3-120b
CRITIC_MODEL=nvidia/nemotron-3-120b

# Chain-of-thought style flag for reasoning agents (app will read this later)
ENABLE_THINKING=true

# --- Local FastMCP ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=stdio

# --- Market data (fill when you wire tools) ---
FINNHUB_API_KEY=
MASSIVE_API_KEY=
# The DataAgent (prometheus/agents/data_clerk/data_agent.py) reads POLYGON_API_KEY, not MASSIVE_API_KEY.
POLYGON_API_KEY=
# Folder for the news files: the DataAgent writes them and prometheus/rag reads them.
# Default: news/ at the repo root. A relative path is resolved against the repo root.
# NEWS_OUTPUT_DIR=news

# --- RAG / embeddings (prometheus/rag). When these are unset, the values shown are used. ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu or cuda. The scores are the same either way; only the speed differs.
# EMBEDDING_DEVICE=cpu
# VECTOR_STORE_PATH=data/processed/vectorstore

# --- Trading simulation ---
PAPER_TRADING=true
INITIAL_CASH=1000
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
