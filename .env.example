# Copy to .env and fill in values. Never commit .env.

# --- Local HF CausalLM (main.py / Lab 1.1 port) ---
# Used by prometheus.models.llm.LocalLLM when you run: python main.py
LOCAL_MODEL=Qwen/Qwen3-4B
# LOCAL_MODEL=Qwen/Qwen3-1.7B
# LOCAL_MODEL=Qwen/Qwen3-0.6B
# Optional: set to skip HITL elicitation in main.py (same as --symbol)
# SMOKE_SYMBOL=AAPL

# --- LLM (OpenRouter) ---
# Used by prometheus.models.chat (get_chat_model) for the agents' LLM calls: python -m prometheus.models.chat
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Prometheus

# Default / cheaper models for Data Clerk, Trader, Account Manager
DEFAULT_MODEL=openai/gpt-oss-120b
FAST_MODEL=qwen/qwen3-30b-a3b

# Stronger reasoning models for Advisor & Critic (adjust as you prefer)
ADVISOR_MODEL=nvidia/nemotron-3-super-120b-a12b
CRITIC_MODEL=z-ai/glm-5.3

# true: the Critic does not deny a recommendation because the market is closed (nights, weekends, holidays). Every other check still applies, including a recommendation made on an earlier trading day.
IGNORE_MARKET_HOURS=false

# false: the desk works at the previous business day's market close, as if the market were open (a simulated clock, and a price from the stored bar of that day, not a live quote), so it runs at night, at the weekend and
# on a holiday. true, or not set: the real clock and Finnhub's live quote. It is NOT live trading: nothing is ever sent to a broker, and PAPER_TRADING (the Trader's rule) is a separate setting. Design choices entry 76.
USE_LIVE_TRADING=false

# The Account Manager's RaiseFunds Tree of Thought (the thought generator). If you leave it out, openai/gpt-oss-120b is used.
ACCOUNT_MANAGER_MODEL=openai/gpt-oss-120b

# The Trader's tool loop (design/trader_v1_final_spec.md): the model works through the tickets and says what was done; code owns the symbol, the side, the shares and the price limits. If you leave it out, openai/gpt-oss-120b is used.
TRADER_MODEL=openai/gpt-oss-120b

# The Trader trades on paper only (paper or backtest, never live). Anything but true (true, yes, on, 1) refuses every Trader run. If you leave it out, true is used.
PAPER_TRADING=true

# Chain-of-thought style flag for reasoning agents (app will read this later)
ENABLE_THINKING=true

# --- Local FastMCP ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=stdio

# --- Market data (fill when you wire tools) ---
FINNHUB_API_KEY=
MASSIVE_API_KEY=
# The DataAgent (prometheus/agents/data_clerk/data_agent.py) reads POLYGON_API_KEY, not MASSIVE_API_KEY.
POLYGON_API_KEY=
# Folder for the news files: the DataAgent writes them and prometheus/rag reads them.
# Default: news/ at the repo root. A relative path is resolved against the repo root.
# NEWS_OUTPUT_DIR=news
# Folder for the SEC filing files (one <SYMBOL>.txt each): the DataToolbox writes them and prometheus/rag reads them. Default: data/filings.
# FILINGS_OUTPUT_DIR=data/filings
# SEC EDGAR asks every client to say who it is: a name and a contact e-mail. Needed ONLY to fetch the text of a 10-Q from EDGAR (the fetch_filings tool does it
# as an extra step). Without it that step is skipped and reported, and everything else works. There is no default and the code never invents one.
# SEC_USER_AGENT=Your Name you@example.com

# --- RAG / embeddings (prometheus/rag). When these are unset, the values shown are used. ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu or cuda. The scores are the same either way; only the speed differs.
# EMBEDDING_DEVICE=cpu
# VECTOR_STORE_PATH=data/processed/vectorstore

# --- Trading simulation ---
PAPER_TRADING=true
INITIAL_CASH=1000
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
