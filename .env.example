# Copy to .env and fill in values. Never commit .env.

# --- LLM (OpenRouter) ---
# Used by your Prometheus app code (LangChain / LangGraph / OpenAI-compatible clients).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Prometheus

# Default / cheaper models for Data Clerk, Trader, Account Manager
DEFAULT_MODEL=openai/gpt-oss-120b
FAST_MODEL=qwen/qwen3-30b-a3b

# Stronger reasoning models for Advisor & Critic (adjust as you prefer)
ADVISOR_MODEL=nvidia/nemotron-3-120b
CRITIC_MODEL=nvidia/nemotron-3-120b

# Chain-of-thought style flag for reasoning agents (app will read this later)
ENABLE_THINKING=true

# --- Local FastMCP ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=stdio

# --- Market data (fill when you wire tools) ---
FINNHUB_API_KEY=
MASSIVE_API_KEY=

# --- RAG / embeddings (fill when you add vector store) ---
# EMBEDDING_MODEL=
# VECTOR_STORE_PATH=data/processed/vectorstore

# --- Trading simulation ---
PAPER_TRADING=true
INITIAL_CASH=1000
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
